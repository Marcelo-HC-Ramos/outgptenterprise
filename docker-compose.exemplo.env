# Copie este arquivo para ".env" (mesma pasta do docker-compose.yml) e preencha. O .env NAO vai para o GitHub.

# Token do túnel (painel do Cloudflare > Zero Trust > Networks > Tunnels > seu túnel). Obrigatório.
CLOUDFLARE_TUNNEL_TOKEN=

# Endereço público do sistema (precisa estar como Public Hostname do túnel).
OUTGPT_DOMINIO=outgpt.ramosys.com.br

# Senha de uso único para criar o primeiro master na tela "Primeiro acesso". Use um valor longo e aleatório.
OUTGPT_SETUP_TOKEN=

# Opcional: chave da IA (também dá para colar depois em Administração > Inteligência artificial).
ANTHROPIC_API_KEY=