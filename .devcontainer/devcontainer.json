{
  "name": "OutGPT Enterprise",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "hostRequirements": { "cpus": 2, "memory": "4gb" },
  "containerEnv": {
    "OUTGPT_HOST": "0.0.0.0",
    "OUTGPT_PORTA": "8000",
    "OUTGPT_COOKIE_SECURE": "1",
    "OUTGPT_CONFIAR_PROXY": "1"
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": { "label": "OutGPT Enterprise", "onAutoForward": "openBrowser" }
  },
  "postCreateCommand": "bash .devcontainer/preparar.sh",
  "postStartCommand": "bash .devcontainer/iniciar.sh",
  "customizations": { "vscode": { "extensions": ["ms-python.python"] } }
}