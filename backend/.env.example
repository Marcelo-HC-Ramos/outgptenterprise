# Copie este arquivo para ".env" (na mesma pasta) e preencha. O arquivo .env NAO vai para o GitHub.

# Chave da API da Anthropic (https://console.anthropic.com). Sem ela o assistente funciona so como busca,
# sem a resposta gerada pela LLM.
ANTHROPIC_API_KEY=

# Modelo da LLM (opcional). Padrao: claude-opus-5-5. Para custo menor: claude-haiku-5-5
# OUTGPT_MODELO=claude-opus-5-5

# Esforco de raciocinio: low (rapido e barato, padrao) | medium | high
# OUTGPT_ESFORCO=low

# Em producao com HTTPS, mantenha o cookie de sessao so em conexoes seguras
# OUTGPT_COOKIE_SECURE=1